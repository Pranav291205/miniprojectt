# ==============================================================================
# TrafficIQ - Environment Configuration Template
# Copy this file to .env or set environment variables in your deployment environment
# ==============================================================================

# Server Port
SERVER_PORT=8080

# Active Spring Profile (h2 for in-memory demo, mysql for persistent database)
SPRING_PROFILES_ACTIVE=h2

# MySQL Database Configuration (Required only when SPRING_PROFILES_ACTIVE=mysql)
DB_URL=jdbc:mysql://localhost:3306/trafficiq?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Google Maps API Key for Real-Time Traffic Layer, Roadmap & Satellite Hybrid Tiles
# Leave empty to use CartoDB Dark Matter & OpenStreetMap fallback mode
MAPS_API_KEY=AIzaSyD0JIwXnofK8a7xvVrlSuYHqA3iwUcubg4

# OpenStreetMap / OSRM Routing Engine URL
OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
OSRM_TIMEOUT_MS=5000
